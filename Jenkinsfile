pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Code downloaded from GitHub'
            }
        }

        stage('Build') {
            steps {
                echo 'Building Web Application'
            }
        }

        stage('Test') {
            steps {
                echo 'Testing Web Application'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying Web Application'
            }
        }
    }
}